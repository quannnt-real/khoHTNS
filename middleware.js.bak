import { NextResponse } from 'next/server';
import { monkeyPatchNextResponse } from './lib/redirect-monitor';

// Middleware xử lý các yêu cầu trước khi chúng đến route handler
// Kích hoạt monkey patch ngay khi module được load
monkeyPatchNextResponse();

export function middleware(request) {
  // Thêm biện pháp an toàn để tránh lỗi redirect với URL undefined
  const url = request.nextUrl.clone();
  
  // Nếu đường dẫn không hợp lệ, chuyển hướng về trang chủ
  if (!url || !url.pathname) {
    console.error('[Middleware] Phát hiện URL không hợp lệ');
    return NextResponse.redirect(new URL('/', request.url));
  }
  
  // Kiểm tra nếu người dùng truy cập các đường dẫn bảo vệ nhưng không có xác thực
  // (Thông thường xác thực được xử lý bởi AuthContext và ProtectedRoute)
  
  // Tiếp tục đến route handler tiếp theo
  return NextResponse.next();
}

// Chỉ áp dụng middleware cho các đường dẫn cụ thể
export const config = {
  matcher: [
    // Áp dụng cho tất cả các trang
    '/((?!api|_next/static|_next/image|favicon.ico).*)',
  ],
};